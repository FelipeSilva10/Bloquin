# Bloquin IDE — Variáveis de ambiente
# Copie este arquivo para .env e preencha com suas credenciais do Supabase.
# NUNCA commite o arquivo .env no repositório.

# URL do projeto Supabase
# Encontre em: Supabase Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Chave pública (anon) do Supabase
# Encontre em: Supabase Dashboard → Settings → API → anon public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
