{
  "name": "bloquin",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:library": "node --experimental-strip-types --test scripts/library-validation.test.mjs",
    "test:projects": "node --experimental-strip-types --test scripts/project-validation.test.mjs",
    "test:sessions": "node --experimental-strip-types --test scripts/session-policy.test.mjs",
    "test:welcome": "node --test scripts/welcome-screen-validation.test.mjs",
    "test:layout": "node --test scripts/ide-layout-validation.test.mjs",
    "test:components": "node --test scripts/components-validation.test.mjs",
    "test:sag": "node --test scripts/sag-integration.test.mjs",
    "test:version": "node --experimental-strip-types --test scripts/version-validation.test.mjs",
    "test:installer": "node --test scripts/windows-installer-validation.test.mjs",
    "test:local-projects": "node --test scripts/local-project-persistence-validation.test.mjs",
    "test:project-date": "node --experimental-strip-types --test scripts/project-date-validation.test.mjs",
    "test:project-ux": "node --test scripts/project-card-ux-validation.test.mjs",
    "test:blocks": "node scripts/run-blockly-audit.mjs",
    "test:blocks:compile": "node scripts/run-blockly-audit.mjs --compile",
    "test:block-docs": "node --test scripts/block-docs-validation.test.mjs",
    "test": "npm run test:library && npm run test:projects && npm run test:sessions && npm run test:welcome && npm run test:layout && npm run test:components && npm run test:sag && npm run test:version && npm run test:installer && npm run test:local-projects && npm run test:project-date && npm run test:project-ux && npm run test:blocks && npm run test:block-docs",
    "test:hardware": "npm run test:blocks:compile",
    "audit:blocks": "node scripts/run-blockly-audit.mjs",
    "audit:supabase-baseline": "node scripts/supabase-baseline-audit.mjs",
    "test:supabase-db": "supabase test db --local supabase/tests/database",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "supabase": "supabase",
    "tauri": "tauri",
    "tauri:windows": "tauri build --bundles nsis && node scripts/rename-windows-installer.mjs",
    "icons:generate": "tauri icon src/assets/LogoSimples.png"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "blockly": "^12.4.1",
    "lucide-react": "^1.28.0",
    "lz-string": "^1.5.0",
    "pdfjs-dist": "6.1.200",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "7.18.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/lz-string": "^1.3.34",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "26.1.0",
    "supabase": "2.110.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
