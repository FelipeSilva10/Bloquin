{
  "productName": "Bloquin",
  "version": "2.7.3",
  "identifier": "com.bloquin.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bloquin",
        "width": 1000,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
        "csp": "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.github.com; img-src 'self' data: blob: asset: https://*.supabase.co https://i.ytimg.com; frame-src 'self' https://www.youtube-nocookie.com https://*.supabase.co; media-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; font-src 'self' data: https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "createUpdaterArtifacts": true,
    "publisher": "Felipe da Conceição Silva",
    "shortDescription": "Bloquin IDE",
    "longDescription": "Ambiente visual de programação para Arduino e ESP32 voltado para o ensino.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4RTlERDAxQzIzMTUzNjYKUldSbVV6SENBZDNwcUhHY1ZCYUpKT00wckJZSVJOWWhYY2Q2WUs0RFVTZWdzVytaeHI4dytxbjYK",
      "endpoints": [
        "https://github.com/FelipeSilva10/Bloquin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
